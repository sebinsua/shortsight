{
	"name": "shorthand-workspace",
	"private": true,
	"description": "Workspace for shorthand-code, pi-shorthand and sightread.",
	"license": "MIT",
	"workspaces": [
		"packages/shorthand-code",
		"packages/pi-shorthand",
		"packages/sightread"
	],
	"type": "module",
	"scripts": {
		"test": "bun test ./packages/shorthand-code/test ./packages/pi-shorthand/test ./packages/sightread/test ./e2e/test",
		"typecheck": "tsc -p .",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt",
		"check": "tsc -p . && oxlint --deny-warnings && oxfmt --check",
		"prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.99.1",
		"@earendil-works/pi-coding-agent": "^0.99.1",
		"@earendil-works/pi-tui": "^0.99.1",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.1",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"typebox": "^1.3.7",
		"typescript": "7.0.2"
	},
	"pi": {
		"extensions": [
			"./packages/pi-shorthand/src/index.ts"
		]
	}
}
